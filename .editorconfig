root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,asmdef,asmref,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Preserve Unity's generated serialization rather than reformatting it.
[*.{unity,prefab,asset,meta,mat,anim,controller}]
indent_size = 2
trim_trailing_whitespace = false
